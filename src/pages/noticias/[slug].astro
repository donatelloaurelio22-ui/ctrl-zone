
---
import { noticias } from "../../data/noticias";

export function getStaticPaths() {
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const dataFormatada = new Date(
  `${noticia.data}T12:00:00`
).toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={noticia.resumo} />
    <title>{noticia.titulo} // CTRL ZONE</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #080b11;
        --card: #111720;
        --lime: #39ff14;
        --text: #e5e7eb;
        --muted: #9ca3af;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.75;
      }

      header {
        padding: 24px 6%;
        border-bottom: 1px solid #27303b;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
      }

      a { color: var(--lime); text-decoration: none; }

      .brand {
        font-weight: 900;
        letter-spacing: -1px;
        font-size: 1.3rem;
      }

      .tag {
        color: var(--lime);
        font-size: 0.75rem;
        letter-spacing: 2px;
      }

      main {
        width: min(760px, 88%);
        margin: 70px auto 100px;
      }

      .back { font-size: 0.9rem; }

      h1 {
        font-size: clamp(2.4rem, 7vw, 4.8rem);
        line-height: 1.04;
        letter-spacing: -2px;
        margin: 20px 0;
      }

      .summary {
        font-size: 1.2rem;
        color: var(--muted);
      }

      .meta {
        color: var(--muted);
        font-size: 0.85rem;
        margin: 28px 0 36px;
      }

      .cover {
        width: 100%;
        border-radius: 8px;
        margin-bottom: 30px;
      }

      article p { font-size: 1.08rem; margin: 0 0 24px; }

      footer {
        border-top: 1px solid #27303b;
        padding: 28px 6%;
        color: var(--muted);
        font-size: 0.8rem;
      }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="/">CTRL ZONE</a>
      <span class="tag">INDEPENDENT DIGITAL CULTURE // BRASIL</span>
    </header>

    <main>
      <a class="back" href="/">← VOLTAR À CTRL ZONE</a>

      <p class="tag">{noticia.categoria}</p>
      <h1>{noticia.titulo}</h1>
      <p class="summary">{noticia.resumo}</p>

      <div class="meta">
        Por {noticia.autor} · {dataFormatada}
      </div>

      {noticia.imagem && (
        <img class="cover" src={noticia.imagem} alt={noticia.titulo} />
      )}

      <article>
        {noticia.conteudo.map((paragrafo) => (
          <p>{paragrafo}</p>
        ))}
      </article>

      <p class="tag">/// O SINAL CONTINUA ABERTO</p>
    </main>

    <footer>CTRL ZONE © 2026 // INFORMAÇÃO SEM RUÍDO.</footer>
  </body>
</html>
