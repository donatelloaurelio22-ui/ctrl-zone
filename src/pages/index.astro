
---
const categories = [
  { name: 'GAMES', href: '#games' },
  { name: 'INTELIGÊNCIA ARTIFICIAL', href: '#ia' },
  { name: 'HARDWARE', href: '#hardware' },
  { name: 'CIÊNCIA', href: '#ciencia' }
];

const stories = [
  {
    category: 'INTELIGÊNCIA ARTIFICIAL',
    id: 'ia',
    title: 'A nova era da IA está mudando a forma como criamos',
    description: 'Ferramentas, modelos e tecnologias que estão redefinindo o cenário digital.',
    tag: 'INTELIGÊNCIA',
    time: 'EM DESTAQUE'
  },
  {
    category: 'GAMES',
    id: 'games',
    title: 'O que vem por aí no universo dos games?',
    description: 'Lançamentos, atualizações e tendências para acompanhar.',
    tag: 'GAMES',
    time: 'RADAR'
  },
  {
    category: 'HARDWARE',
    id: 'hardware',
    title: 'Hardware: tecnologia além das especificações',
    description: 'Componentes, desempenho e novidades do mundo do PC.',
    tag: 'HARDWARE',
    time: 'LAB'
  },
  {
    category: 'CIÊNCIA',
    id: 'ciencia',
    title: 'As descobertas que merecem sua atenção',
    description: 'Ciência e inovação explicadas sem complicação.',
    tag: 'CIÊNCIA',
    time: 'EXPLORA'
  }
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b11" />
    <meta
      name="description"
      content="CTRL ZONE — games, inteligência artificial, hardware e ciência. Fique por dentro do que está movendo o mundo digital."
    />
    <title>CTRL ZONE — O futuro não espera</title>
    <style>
      :root {
        --bg: #080b11;
        --panel: #111720;
        --line: #252d37;
        --lime: #39ff14;
        --text: #e5e7eb;
        --muted: #929baa;
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, Arial, sans-serif;
      }

      a { color: inherit; text-decoration: none; }

      .wrap {
        width: min(1160px, calc(100% - 40px));
        margin: auto;
      }

      .topline {
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        font: 11px monospace;
        letter-spacing: 2px;
        padding: 11px 0;
        text-transform: uppercase;
      }

      header {
        border-bottom: 1px solid var(--line);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 25px 0;
      }

      .logo {
        font-size: clamp(25px, 4vw, 34px);
        font-weight: 950;
        letter-spacing: -2px;
        white-space: nowrap;
      }

      .logo span { color: var(--lime); }

      .navlinks {
        display: flex;
        flex-wrap: wrap;
        gap: 19px;
        font: 10px monospace;
        color: var(--muted);
      }

      .navlinks a:hover,
      .category:hover { color: var(--lime); }

      .hero {
        padding: 68px 0 55px;
        border-bottom: 1px solid var(--line);
      }

      .eyebrow {
        color: var(--lime);
        font: 11px monospace;
        letter-spacing: 3px;
        text-transform: uppercase;
      }

      h1 {
        max-width: 900px;
        font-size: clamp(46px, 9vw, 104px);
        line-height: .91;
        letter-spacing: -6px;
        margin: 25px 0;
        font-weight: 950;
      }

      h1 span {
        color: var(--lime);
        text-shadow: 3px 3px 0 #1a6120;
      }

      .hero-bottom {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 24px;
        margin-top: 35px;
      }

      .hero-bottom p {
        max-width: 440px;
        color: var(--muted);
        line-height: 1.8;
        font-size: 14px;
        margin: 0;
      }

      .signal {
        color: var(--lime);
        font: 11px monospace;
        white-space: nowrap;
      }

      .section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin: 35px 0 22px;
      }

      h2 {
        font-size: 18px;
        letter-spacing: -0.5px;
        margin: 0;
      }

      .section-head small {
        color: var(--muted);
        font: 10px monospace;
      }

      .feature {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        min-height: 270px;
        border: 1px solid var(--line);
        background: var(--panel);
      }

      .feature-art {
        min-height: 260px;
        display: flex;
        align-items: end;
        padding: 25px;
        overflow: hidden;
        background:
          radial-gradient(ellipse at 65% 35%, #244c24 0, transparent 28%),
          repeating-linear-gradient(135deg, transparent 0 18px, #ffffff08 19px 20px),
          #0d131a;
      }

      .feature-art strong {
        color: var(--lime);
        font-size: clamp(40px, 7vw, 78px);
        line-height: .85;
        letter-spacing: -5px;
        text-shadow: 3px 3px 0 #182e19;
      }

      .feature-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 30px;
      }

      .label {
        color: var(--lime);
        font: 10px monospace;
        letter-spacing: 1.5px;
      }

      .feature-copy h3 {
        font-size: clamp(25px, 3vw, 36px);
        letter-spacing: -1.5px;
        line-height: 1.1;
        margin: 18px 0 12px;
      }

      .feature-copy p,
      .story p {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.7;
      }

      .read {
        margin-top: 18px;
        font: 11px monospace;
        color: var(--lime);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 65px;
      }

      .story {
        display: flex;
        flex-direction: column;
        min-height: 225px;
        border: 1px solid var(--line);
        padding: 22px;
        background: linear-gradient(145deg, #121821, #0b0f15);
        transition: border-color .2s, transform .2s;
      }

      .story:hover {
        border-color: var(--lime);
        transform: translateY(-3px);
      }

      .story h3 {
        font-size: 21px;
        line-height: 1.2;
        letter-spacing: -.7px;
        margin: 18px 0 0;
      }

      .story p { margin-bottom: 0; }

      .story .read { margin-top: auto; padding-top: 20px; }

      .notice {
        border-left: 2px solid var(--lime);
        padding: 12px 16px;
        background: #10170f;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.7;
        margin: 0 0 45px;
      }

      footer {
        border-top: 1px solid var(--line);
        padding: 28px 0;
        color: var(--muted);
        font: 11px monospace;
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        flex-wrap: wrap;
      }

      @media (max-width: 760px) {
        .nav { align-items: flex-start; flex-direction: column; }
        .navlinks { gap: 13px; }
        .hero { padding-top: 48px; }
        h1 { letter-spacing: -3px; }
        .hero-bottom { align-items: flex-start; flex-direction: column; }
        .feature { grid-template-columns: 1fr; }
        .feature-art { min-height: 190px; }
        .grid { grid-template-columns: 1fr; }
        .story { min-height: 190px; }
      }
    </style>
  </head>
  <body>
    <div class="topline">
      <div class="wrap">INDEPENDENT DIGITAL CULTURE // BRASIL</div>
    </div>

    <header>
      <div class="wrap nav">
        <a class="logo" href="/">CTRL<span>ZONE</span></a>
        <nav class="navlinks" aria-label="Categorias">
          {categories.map((category) => (
            <a href={category.href}>{category.name}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="wrap">
      <section class="hero">
        <div class="eyebrow">/// O sinal está aberto</div>
        <h1>O FUTURO<br />NÃO <span>ESPERA.</span></h1>
        <div class="hero-bottom">
          <p>
            Games, inteligência artificial, hardware e ciência.
            O que está movendo o mundo digital, sem ruído desnecessário.
          </p>
          <div class="signal">[ SYSTEM ONLINE ]</div>
        </div>
      </section>

      <div class="section-head">
        <h2>EM DESTAQUE<span style="color:var(--lime)">.</span></h2>
        <small>CTRL / 001</small>
      </div>

      <section class="feature" id="ia">
        <div class="feature-art" aria-label="Arte gráfica conceitual">
          <strong>CTRL<br />THE<br />FUTURE.</strong>
        </div>
        <div class="feature-copy">
          <div class="label">INTELIGÊNCIA ARTIFICIAL / RADAR</div>
          <h3>Entenda as tecnologias que estão mudando o jogo.</h3>
          <p>
            Um ponto de partida para explorar as novidades que
            importam no universo digital.
          </p>
          <div class="read">PRIMEIRA EDIÇÃO // EM BREVE</div>
        </div>
      </section>

      <div class="section-head">
        <h2>EXPLORE O SINAL<span style="color:var(--lime)">.</span></h2>
        <small>04 FREQUÊNCIAS</small>
      </div>

      <section class="grid" aria-label="Categorias editoriais">
        {stories.map((story) => (
          <article class="story" id={story.id}>
            <div class="label">{story.category}</div>
            <h3>{story.title}</h3>
            <p>{story.description}</p>
            <div class="read">SEÇÃO: {story.tag} ↗</div>
          </article>
        ))}
      </section>

      <aside class="notice">
        <strong style="color:var(--lime)">NOTA DE DESENVOLVIMENTO //</strong>
        A CTRL ZONE está em construção. Os textos desta versão são
        demonstrativos, não notícias publicadas. O conteúdo editorial
        será adicionado após a configuração da estrutura de artigos.
      </aside>
    </main>

    <footer>
      <div class="wrap footer-inner">
        <span>CTRL ZONE © 2026</span>
        <span>INDEPENDENT BY DESIGN.</span>
      </div>
    </footer>
  </body>
</html>
